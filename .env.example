# ============================================================================
# FLOW — environment configuration
# Copy this file to `.env` and fill in your Supabase project credentials.
# Find these in Supabase Dashboard > Project Settings > API.
# ============================================================================

# Your Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# The "anon" public API key (safe to ship in the browser — RLS protects data).
VITE_SUPABASE_ANON_KEY=
